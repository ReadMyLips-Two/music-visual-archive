# Public Spotify application identifier. Do not put a Client Secret in a Vite app.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# MusicKit on the Web configuration. The endpoint returns { "developerToken": "..." }.
# The Apple Music private key must remain on that backend; never put it in Vite.
VITE_APPLE_MUSICKIT_APP_NAME=Music Visual Archive
VITE_APPLE_MUSICKIT_DEVELOPER_TOKEN_ENDPOINT=/api/apple-music/developer-token
